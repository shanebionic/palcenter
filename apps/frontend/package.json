{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:production-css": "node scripts/assert-production-css.mjs && playwright test e2e/production-css.spec.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mantine/notifications": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  }
}
